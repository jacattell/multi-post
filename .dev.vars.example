# Local settings. Copy to .dev.vars (never commit it).
# In production these are set with: npx wrangler secret put NAME

# Who may sign in: email addresses, separated by commas.
ALLOWED_EMAILS=you@example.com
# Any long random text. Signs your login and encrypts stored account tokens.
SESSION_SECRET=change-me-to-something-long-and-random

# Sign-in methods. Set up at least one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: needed only to connect X (from your app at developer.x.com).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: needed only to connect LinkedIn (from linkedin.com/developers).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: suggests alt text for images (from platform.claude.com).
ANTHROPIC_API_KEY=
