{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-post",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multi-post",
      "database_id": "a5a20502-2e94-4e38-9820-d30ee299bc0a",
      "migrations_dir": "migrations"
    }
  ],
  // The app's own domain is the only address. The workers.dev address and
  // preview addresses are switched off, so there is one front door to watch.
  "routes": [{ "pattern": "multi-post.cattell.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Logs: errors and console output are kept, but not a line for every request,
  // and addresses are stored without the part after "?". Sign-in links carry
  // one-time codes there, which should not sit in logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
