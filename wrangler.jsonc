{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-post",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multi-post",
      "database_id": "a5a20502-2e94-4e38-9820-d30ee299bc0a",
      "migrations_dir": "migrations"
    }
  ],
  // The app's own domain. The workers.dev address keeps working too.
  "routes": [{ "pattern": "multi-pass.cattell.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
