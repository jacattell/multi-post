# Security headers for the page, its script and its styles. Cloudflare reads this
# file; it is not served. API replies get theirs in src/worker.js.
#
# The policy only lets the browser run this app's own script and styles, and
# talk to this app. Images may come from anywhere secure (profile pictures),
# or from the browser itself (previews of images you attach).
# Referrer-Policy must not be "no-referrer": browsers would then hide where
# requests come from, and the app refuses changes it can't place (see worker.js).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: blob: data:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
