# Everything here is optional. Copy to .env and fill in what you have.
# Without credentials, a platform falls back to "copy text + open its composer".

PORT=3000

# Bluesky: create an app password at Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: your home server, and an access token with write:statuses and read:search
# (Preferences > Development > New application)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=

# X: a bearer token lets the app verify @handles. Optional.
X_BEARER_TOKEN=
